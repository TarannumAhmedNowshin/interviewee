# ─── Azure OpenAI (GPT-5) ───────────────────────────
AZURE_GPT5_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_GPT5_API_KEY=
AZURE_GPT5_API_VERSION=2024-12-01-preview
AZURE_GPT5_DEPLOYMENT=gpt-5

# ─── Azure OpenAI (GPT-5 mini) ──────────────────────
AZURE_GPT5_MINI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_GPT5_MINI_API_KEY=
AZURE_GPT5_MINI_API_VERSION=2024-12-01-preview
AZURE_GPT5_MINI_DEPLOYMENT=gpt-5-mini

# ─── Azure OpenAI Embeddings (text-embedding-3-large) ───
AZURE_OPENAI_EMBED_API_KEY=
AZURE_OPENAI_EMBED_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBED_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_EMBED_MODEL=text-embedding-3-large
AZURE_OPENAI_EMBED_DIMENSIONS=3072

# ─── Whisper (speech-to-text) ───────────────────────
WHISPER_KEY=
WHISPER_DEPLOYMENT=whisper
WHISPER_API_VERSION=2024-06-01
WHISPER_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>

# ─── Azure AI Speech (text-to-speech) ───────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-Ava:DragonHDLatestNeural
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/

# ─── Database (local Docker Postgres + pgvector) ────
# Keep POSTGRES_PASSWORD in sync with docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interviewwee
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/interviewwee
